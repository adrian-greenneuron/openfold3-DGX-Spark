# Experimental original-model deployment using stock current DeepSpeed.
# =============================================================================
# OpenFold3 Dockerfile for NVIDIA DGX Spark (ARM64 / Grace Blackwell GB10)
# =============================================================================
# Base Image: NGC PyTorch 25.11-py3 (Contains CUDA 13.0, PyTorch 2.10)
# This base image provides native Blackwell nvrtc sm_120/sm_121 support.

FROM nvcr.io/nvidia/pytorch:25.11-py3@sha256:417cbf33f87b5378849df37983552cd1f8bc8b62fe1ceabe004de816a55dff21

# -----------------------------------------------------------------------------
# Build Configuration
# -----------------------------------------------------------------------------
ENV MAX_JOBS=16 \
    NVCC_THREADS=8 \
    OMP_NUM_THREADS=16 \
    TORCH_CUDA_ARCH_LIST="12.1" \
    CUTLASS_PATH=/opt/cutlass \
    KMP_AFFINITY=none \
    PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    DEBIAN_FRONTEND=noninteractive

# -----------------------------------------------------------------------------
# System Dependencies
# -----------------------------------------------------------------------------
RUN --mount=type=cache,target=/var/cache/apt,sharing=locked \
    --mount=type=cache,target=/var/lib/apt,sharing=locked \
    apt-get update && apt-get install -y --no-install-recommends \
    hmmer kalign aria2 libxrender1 libxext6 libsm6 libxft2

# -----------------------------------------------------------------------------
# Python Dependencies
# -----------------------------------------------------------------------------
COPY runtime-legacy-modern.txt /opt/runtime-constraints.txt
ENV PIP_CONSTRAINT=/opt/runtime-constraints.txt
RUN --mount=type=cache,target=/root/.cache/pip \
    pip install --no-cache-dir \
    rdkit biopython typing-extensions modelcif memory_profiler \
    func_timeout pdbeccdutils pytorch-lightning biotite==1.2.0 \
    "nvidia-cutlass<4" py-cpuinfo lmdb aria2p ijson boto3 \
    ml-collections wandb awscli tqdm pyyaml requests pandas scipy numpy

# -----------------------------------------------------------------------------
# CUTLASS & OpenFold3 Source
# -----------------------------------------------------------------------------
WORKDIR /opt
RUN git clone https://github.com/NVIDIA/cutlass --branch v3.6.0 --depth 1 \
    && test "$(git -C /opt/cutlass rev-parse HEAD)" = "bf9da7b76c766d7ee7d536afc77880a4ef1f1156" \
    && git clone https://github.com/aqlaboratory/openfold-3.git \
    && git -C /opt/openfold-3 checkout --detach d8afcd3485388d28b2dfd949a202672720693668

# Stock DeepSpeed supports native GB10 architecture parsing. Build the attention
# extension in a regular GPU-less Docker build; no patch or docker commit.
RUN --mount=type=cache,target=/root/.cache/pip \
    DS_ACCELERATOR=cuda DS_BUILD_OPS=0 DS_BUILD_EVOFORMER_ATTN=1 \
    pip install --no-cache-dir --no-binary=deepspeed --no-build-isolation deepspeed==0.19.8

# Install OpenFold3 (--no-deps prevents overwriting NGC PyTorch)
WORKDIR /opt/openfold-3
RUN pip install --no-deps -e .

# -----------------------------------------------------------------------------
# Triton Configuration
# -----------------------------------------------------------------------------
# NGC 25.11+ includes Triton 3.5.0 with native CUDA 13 and Blackwell support.
# Do NOT install Triton nightly here - it bundles CUDA 12.8 PTXAS which causes
# significant performance regression on CUDA 13.
#

# -----------------------------------------------------------------------------
# Runtime Setup
# -----------------------------------------------------------------------------
# Pre-create cache directories
RUN mkdir -p /root/.openfold3 /root/.triton/autotune

# Download model parameters
RUN bash /opt/openfold-3/openfold3/scripts/download_openfold3_params.sh --download_dir=/root/.openfold3 \
    && echo "aedd8f3eb814e3926c8974ef34c9499df224443f173b7e396c97684da6e3eeb6  /root/.openfold3/of3_ft3_v1.pt" | sha256sum --check -
# Verification is opt-in; the normal CLI and model configuration are unchanged.
COPY tools /opt/openfold3-deployment/tools

WORKDIR /opt/openfold-3
CMD ["/bin/bash"]
